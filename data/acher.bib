  year = {2020},
  doi = {10.1145/3375572.3375582},
  url = {https://doi.org/10.1145/3375572.3375582},
  hal_id = {hal-02471302},
  hal_version = {v1},
  pdf = {https://inria.hal.science/hal-02471302v1/file/MALTESQUE19_WorkshopSummary.pdf},
  timestamp = {Thu, 17 Sep 2020 12:05:37 +0200},
